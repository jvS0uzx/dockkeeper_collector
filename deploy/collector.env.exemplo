# Modelo de configuracao do coletor. Copie para /etc/dockkeeper-collector.env e
# restrinja:
#   sudo chmod 600 /etc/dockkeeper-collector.env
#
# Este arquivo e versionado e nao deve receber valor real nenhum. O .gitignore
# recusa qualquer *.env que nao termine em .exemplo.

# URL do painel central.
COLLECTOR_SERVER_URL="https://painel.exemplo.com"

# http:// para um painel remoto e recusado no boot: a credencial do coletor
# viajaria em claro. true libera, so em rede confiavel (o boot registra um
# AVISO). http://localhost, 127.0.0.1 e ::1 nao precisam desta variavel.
ALLOW_INSECURE_HTTP="false"

# Identidade preferida: convite de enrollment de uso unico, emitido no painel
# por um admin global (kind "collector", validade 24h). No primeiro boot o
# coletor troca o convite por credencial propria, gravada em
# /var/lib/dockkeeper-collector/credential.json — depois disso esta variavel pode (e
# deve) ser removida: o convite ja foi queimado e nao serve mais.
COLLECTOR_ENROLL_TOKEN=""

# Modo compartilhado, descontinuado: mesmo valor de AGENT_INGEST_TOKEN no
# painel. So e usado quando nao ha credencial propria nem convite, e o painel o
# recusa com 401 a menos que tenha ALLOW_LEGACY_INGEST_TOKEN=true. Nao amarra o
# coletor a uma unidade — migre para o enrollment.
COLLECTOR_TOKEN=""

# Codigo da unidade. Precisa existir cadastrado na tela Unidades do painel:
# o painel recusa o envio de unidade desconhecida.
COLLECTOR_SITE="matriz"

# Faixas varridas, separadas por virgula. So aceita rede privada (RFC1918).
COLLECTOR_CIDRS="192.168.0.0/24"

# Minutos entre varreduras. Minimo 1, padrao 15.
COLLECTOR_INTERVAL_MIN="15"

# Portas sondadas. Vazio usa a lista padrao:
# 22,80,135,139,443,445,515,631,3389,5000,8080,9100
COLLECTOR_PORTS=""

# true faz uma varredura so e encerra (para uso em cron em vez de servico).
COLLECTOR_ONCE="false"

# SNMP v2c. Vazio desliga: o coletor faz so o inventario.
# IPs dos equipamentos (switch, roteador, firewall), separados por virgula.
# So aceita rede interna (RFC 1918, fc00::/7, loopback e link-local).
SNMP_TARGETS=""

# Alvo SNMP fora da rede interna e recusado no boot: a community viajaria em
# claro pela internet. true libera, so se o caminho ate o equipamento for
# confiavel (VPN, link dedicado); o boot registra um AVISO com os alvos.
SNMP_PERMITIR_PUBLICO="false"

# Community de leitura. Obrigatoria se houver alvos. Viaja em texto puro:
# deixe os equipamentos numa VLAN de gerencia e libere o SNMP por ACL so para o
# IP deste coletor. Nunca use a community de escrita.
SNMP_COMMUNITY=""

# So 2c por enquanto; v3 vem numa fase seguinte.
SNMP_VERSION="2c"

# Intervalo entre leituras (60 ou 60s). Minimo 10s, padrao 60s.
SNMP_INTERVAL="60s"

# Prazo de cada requisicao por alvo e repeticoes.
SNMP_TIMEOUT="2s"
SNMP_RETRIES="1"

# Porta UDP do agente SNMP.
SNMP_PORT="161"
